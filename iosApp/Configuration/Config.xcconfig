// The iOS app's identity and version, in one place. Info.plist and the Xcode project read these.
// BUNDLE_ID matches the Android applicationId.
// TEAM_ID only picks the signing team; it never changes the bundle ID.
// Put your Apple team ID in Local.xcconfig next to this file (git-ignored), e.g.
//   TEAM_ID=ABCDE12345
TEAM_ID=
BUNDLE_ID=bridge.supplies.foundation
// Name on the home screen
APP_NAME=Foundation
// Name of the .app and its Swift module; usually the same as APP_NAME. The demo can't use
// "Foundation", which is the name of Apple's framework.
PRODUCT_NAME=Foundation_
// App Store category: https://developer.apple.com/documentation/bundleresources/information-property-list/lsapplicationcategorytype
APP_CATEGORY=public.app-category.utilities
// Keep equal to app-versionName and app-versionCode in gradle/libs.versions.toml
// (scripts/verify.sh warns when they differ).
MARKETING_VERSION=2.2.0
CURRENT_PROJECT_VERSION=202611060

#include? "Local.xcconfig"
